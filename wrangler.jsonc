{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "douyin-download-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "PARSE_LIMITER", "class_name": "ParseRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ParseRateLimiter"] }
  ],
  "routes": [
    { "pattern": "dy.pygojrc.cyou", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
